{
  "name": "yt-downloader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Premium AI-powered YouTube learning studio.",
  "author": "StudyTube Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "electron": "electron .",
    "build": "vite build",
    "win": "vite build && npx rimraf dist-electron && npx electron-builder --win",
    "linux": "vite build && npx electron-builder --linux",
    "build:all": "vite build && npx electron-builder --win --mac --linux",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.studytube.app",
    "productName": "StudyTube",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "data/**/*"
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "youtube-dl-exec": "^3.1.4",
    "youtube-transcript": "^1.3.0",
    "youtube-transcript-api": "^3.0.6",
    "yt-search": "^2.13.1"
  }
}

{
  "name": "yt-downloader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "electron": "electron .",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "youtube-dl-exec": "^3.1.4",
    "youtube-transcript": "^1.3.0",
    "youtube-transcript-api": "^3.0.6",
    "yt-search": "^2.13.1"
  }
}

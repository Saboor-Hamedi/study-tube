{
  "name": "yt-downloader",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Premium AI-powered YouTube learning studio.",
  "author": "StudyTube Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "electron": "electron .",
    "build": "vite build",
    "win": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --win",
    "build:win": "npm run win",
    "mac": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --mac",
    "build:mac": "npm run mac",
    "linux": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --linux",
    "build:linux": "npm run linux",
    "build:all": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --win --mac --linux",
    "publish": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --win --linux -p always",
    "publish:win": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --win -p always",
    "publish:linux": "vite build && cross-env ELECTRON_BUILDER_CACHE=.builder-cache npx electron-builder --linux -p always",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.studytube.app",
    "productName": "StudyTube",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "data/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Saboor-Hamedi",
        "repo": "study-tube"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "app-builder-bin": "^5.0.0-alpha.12",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "youtube-dl-exec": "^3.1.4",
    "youtube-transcript": "^1.3.0",
    "youtube-transcript-api": "^3.0.6",
    "yt-search": "^2.13.1"
  }
}

{
  "name": "writella",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "description": "Premium AI-powered writing assistant.",
  "author": "Saboor Hamedi",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:web": "concurrently -k \"vite --port 5173 --strictPort\" \"npm:dev:cloud\"",
    "dev:electron": "concurrently -k \"npm:dev:web\" \"npm:electron:dev\"",
    "dev:cloud": "uvicorn server.main:app --reload --port 8000",
    "python:dev": "python electron/services/ai_detection.py",
    "electron:dev": "wait-on tcp:5173 && electron .",
    "electron": "electron .",
    "build": "vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:win": "npm run rebuild && npm run build && electron-builder --win",
    "publish:win": "npm run rebuild && npm run build && npx dotenv-cli -- electron-builder --win --publish always",
    "publish:linux": "npm run rebuild && npm run build && npx dotenv-cli -- electron-builder --linux --publish always",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.studytube.app",
    "productName": "StudyTube",
    "directories": {
      "output": "dist-electron"
    },
    "asarUnpack": [
      "electron/services/**",
      "server/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "electron/grammars/**/*",
      "node_modules/**/*",
      "package.json",
      "data/**/*"
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "target": "nsis",
      "publish": [
        {
          "provider": "github",
          "owner": "Saboor-Hamedi",
          "repo": "study-tube",
          "releaseType": "release"
        }
      ]
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "app-builder-bin": "^5.0.0-alpha.12",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.4",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/header": "^2.8.8",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "youtube-dl-exec": "^3.1.4",
    "youtube-transcript": "^1.3.0",
    "youtube-transcript-api": "^3.0.6",
    "yt-search": "^2.13.1",
    "zustand": "^5.0.12"
  }
}
